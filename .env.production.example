# Production env for the Linode app node. Copy to `.env` on the server and fill in.
# NEVER commit the real .env. Compose reads this via env_file.

# --- Managed Postgres (Linode Managed Database), dedicated app role ---
# Use the HOSTNAME (not IP) so cert verification matches, and sslmode=no-verify
# (the migrate tool reads this; the app enforces TLS via DATABASE_CA_CERT_FILE).
DATABASE_URL=postgres://bp_app:CHANGE_ME@a492716-akamai-prod-1220048-default.g2a.akamaidb.net:23200/businesspulse?sslmode=no-verify
# Cert-pinned TLS (verify-full) for the app. Place the CA cert you downloaded at
# ./certs/db-ca.crt on the node; compose mounts it read-only into the container.
DATABASE_CA_CERT_FILE=/app/certs/db-ca.crt

# --- Valkey (container on this node) ---
# REDIS_URL is assembled by compose from VALKEY_PASSWORD — just set the password.
VALKEY_PASSWORD=CHANGE_ME_long_random

# --- Auth (better-auth) ---
# openssl rand -base64 48
BETTER_AUTH_SECRET=CHANGE_ME
BETTER_AUTH_URL=https://businesspulse.app
BP_ALLOW_SIGNUP=false

# --- Public app URL (inlined at build; also used at runtime) ---
NEXT_PUBLIC_APP_URL=https://businesspulse.app

# --- Connector credential encryption (AES-256-GCM) ---
# openssl rand -base64 32
CONNECTOR_ENC_KEY=CHANGE_ME

# --- AI (Anthropic) ---
ANTHROPIC_API_KEY=CHANGE_ME

# --- Email (Mailtrap) ---
MAILTRAP_API_TOKEN=CHANGE_ME
MAILTRAP_SENDER=alerts@businesspulse.app

# --- AEO worker ---
PERPLEXITY_API_KEY=CHANGE_ME
# Runs wait (never drop) once today's UTC spend reaches this.
AEO_DAILY_SPEND_CAP_USD=10
AEO_SNAPSHOT_QUESTIONS=20
AEO_WORKER_POLL_MS=3000
# A running run with no heartbeat for this long is reclaimed by another worker.
AEO_LEASE_SECONDS=300
AEO_JOB_TIMEOUT_SECONDS=600
AEO_MAX_ATTEMPTS=3
AEO_RETRY_DELAY_SECONDS=60
# Perplexity rate-limits readily: 3 at once lost 13 of 20 answers in a live snapshot.
AEO_PANEL_CONCURRENCY=2
# Writes questions for businesses no canned panel fits (uses ANTHROPIC_API_KEY).
AEO_PANEL_MODEL=claude-sonnet-5

# --- Public snapshot form ---
# Cloudflare Turnstile. Both are read at request time, so no rebuild is needed
# to change them. Without the secret, production rejects every submission.
TURNSTILE_SITE_KEY=CHANGE_ME
TURNSTILE_SECRET_KEY=CHANGE_ME
# Deletion-request address shown on /privacy.
AEO_CONTACT_EMAIL=CHANGE_ME
# Receives "snapshot failed" alerts.
AEO_ADMIN_EMAIL=CHANGE_ME

# --- 30-day re-check of consenting leads ---
# One fresh snapshot per lead, 30 days on, then an email comparing the two.
# Costs a snapshot each (counts toward the daily cap). Set to false to stop it.
AEO_RECHECK_ENABLED=true
AEO_RECHECK_DAYS=30
AEO_RECHECK_MAX_PER_DAY=10
# Postal address in the re-check email's footer (CAN-SPAM). Omit to leave it out.
AEO_POSTAL_ADDRESS=

# --- Retention ---
# Days before a request's contact details (email, business name, IP) are erased.
# The run, its answers, and the report stay; leads marked "won" are skipped.
# Keep this in step with the /privacy page, which says four months.
AEO_RETENTION_DAYS=120
# "Book a call" button on reports (https only, e.g. a Calendly link). Reports link to
# /book, which records the click against the report and redirects here. Without it,
# the button emails AEO_CONTACT_EMAIL and clicks aren't recorded.
AEO_BOOKING_URL=

# --- Cron trigger guard ---
# openssl rand -hex 24
CRON_SECRET=CHANGE_ME
